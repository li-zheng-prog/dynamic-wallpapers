// Installer resources: icon, logo, and version metadata.
// build/pack_setup.py generates payload.rc for the embedded installation files.
#include "resource.h"
#include "version.h"
#include <winver.h>

LANGUAGE 0, 0
IDR_DIALOG_MANIFEST 24  "common-controls.manifest"

LANGUAGE 0x09, 0x01 // English (United States).

IDI_APPICON     ICON    "app.ico"
IDR_LOGO_PNG    RCDATA  "logo_ui.png"   // Shared with the main app; generated by build/make_icon.py.

STRINGTABLE
BEGIN
    IDS_SHELL_TITLE "Dynamic Wallpapers Setup"
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     DW_VERSION_NUM
 PRODUCTVERSION  DW_VERSION_NUM
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Dynamic Wallpapers"
            VALUE "FileDescription",  "Dynamic Wallpapers Setup"
            VALUE "FileVersion",      DW_VERSION_TEXT
            VALUE "InternalName",     "DynamicWallpapersSetup"
            VALUE "OriginalFilename", "DynamicWallpapersSetup.exe"
            VALUE "ProductName",      "Dynamic Wallpapers"
            VALUE "ProductVersion",   DW_VERSION_TEXT
            VALUE "LegalCopyright",   "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
