// Installer resources: icon, logo, and version metadata.
// build/pack_setup.py generates payload.rc for the embedded installation files.
#include "resource.h"
#include <winver.h>

LANGUAGE 0x09, 0x01 // English (United States).

IDI_APPICON     ICON    "app.ico"
IDR_LOGO_PNG    RCDATA  "logo_ui.png"   // Shared with the main app; generated by build/make_icon.py.

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,0,0
 PRODUCTVERSION  1,0,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Dynamic Wallpapers"
            VALUE "FileDescription",  "Dynamic Wallpapers Setup"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "DynamicWallpapersSetup"
            VALUE "OriginalFilename", "DynamicWallpapersSetup.exe"
            VALUE "ProductName",      "Dynamic Wallpapers"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "LegalCopyright",   "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
